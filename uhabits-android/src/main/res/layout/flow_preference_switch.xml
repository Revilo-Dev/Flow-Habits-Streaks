<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.SwitchCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/switchWidget"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/flow_min_touch_target"
    android:minWidth="@dimen/flow_min_touch_target"
    android:clickable="true"
    android:focusable="false"
    android:gravity="center"
    android:padding="0dp"
    android:thumb="@drawable/flow_preference_switch_thumb"
    app:showText="false"
    app:splitTrack="false"
    app:thumbTint="@null"
    app:trackTint="@null"
    app:switchMinWidth="@dimen/flow_preference_switch_width"
    app:track="@drawable/flow_preference_switch_track" />
