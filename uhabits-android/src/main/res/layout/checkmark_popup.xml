<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToOutline="true"
    android:fillViewport="false">

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:padding="@dimen/flow_large_spacing">

        <TextView
            android:id="@+id/habitName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/flow_medium_spacing"
            android:accessibilityHeading="true"
            android:fontFamily="sans-serif-medium"
            android:textColor="?attr/flowTextPrimaryColor"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/numberButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/flow_medium_spacing"
            android:orientation="vertical"
            android:visibility="gone">
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:background="@drawable/flow_entry_input_background"
                app:backgroundTint="@null"
                android:backgroundTint="@null"
                android:hint="@string/flow_entry_value"
                android:inputType="numberDecimal"
                android:imeOptions="actionDone"
                android:padding="@dimen/flow_medium_spacing"
                android:selectAllOnFocus="true"
                android:textAlignment="center"
                android:textColor="?attr/flowTextPrimaryColor"
                android:textColorHint="?attr/flowTextSecondaryColor"
                android:textSize="22sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/flow_entry_input_background"
            app:backgroundTint="@null"
            android:backgroundTint="@null"
            android:gravity="start|top"
            android:hint="@string/notes"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2"
            android:maxLines="4"
            android:padding="@dimen/flow_medium_spacing"
            android:textColor="?attr/flowTextPrimaryColor"
            android:textColorHint="?attr/flowTextSecondaryColor"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/booleanButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/flow_large_spacing"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/yesBtn"
                style="@style/Widget.Flow.EntryAction"
                android:contentDescription="@string/flow_entry_complete"
                android:drawableTop="@drawable/flow_ic_entry_check"
                android:drawableTint="?attr/flowAccentColor"
                android:text="@string/flow_entry_done"
                android:textColor="?attr/flowAccentColor" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/skipBtnNumber"
                style="@style/Widget.Flow.EntryAction"
                android:contentDescription="@string/skip_day"
                android:drawableTop="@drawable/flow_ic_entry_minus"
                android:drawableTint="?attr/flowTextPrimaryColor"
                android:text="@string/flow_entry_skip" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/noBtn"
                style="@style/Widget.Flow.EntryAction"
                android:contentDescription="@string/flow_entry_incomplete"
                android:drawableTop="@drawable/flow_ic_entry_close"
                android:drawableTint="?attr/flowTextPrimaryColor"
                android:text="@string/flow_entry_missed" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/numberFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/flow_medium_spacing"
            android:gravity="center"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/dismissBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="120dp"
                android:minHeight="48dp"
                android:background="@drawable/flow_entry_action_background"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="@dimen/flow_extra_large_spacing"
                android:paddingVertical="@dimen/flow_medium_spacing"
                android:text="@android:string/cancel"
                android:textColor="?attr/flowTextPrimaryColor"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
