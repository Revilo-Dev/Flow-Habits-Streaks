<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/flowBackgroundColor">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:layout_behavior="org.isoron.uhabits.utils.FlowHeaderBehavior">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/flow_settings_header_expanded_height"
            app:collapsedTitleTextColor="@android:color/transparent"
            app:contentScrim="@android:color/transparent"
            app:expandedTitleGravity="center"
            app:expandedTitleMarginStart="@dimen/flow_screen_padding"
            app:expandedTitleMarginEnd="@dimen/flow_screen_padding"
            app:expandedTitleTextAppearance="@style/TextAppearance.Flow.ScreenTitle"
            app:title="@string/flow_streak_progress"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:statusBarScrim="@android:color/transparent">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/flow_toolbar_height"
                android:background="@android:color/transparent"
                android:theme="?attr/flowToolbarTheme"
                app:layout_collapseMode="pin"
                app:contentInsetStartWithNavigation="0dp" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/streakScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/flow_scroll_edge_fade_size"
        app:layout_behavior="org.isoron.uhabits.utils.FlowScrollingBehavior">
        <LinearLayout
            android:id="@+id/streakContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/flow_large_spacing">

            <org.isoron.uhabits.activities.habits.show.views.OverviewCardView
                android:id="@+id/overviewCard"
                style="@style/ShowHabit.Flow.BodyCard" />

            <org.isoron.uhabits.activities.habits.show.views.FlowHabitStreakView
                android:id="@+id/currentStreakCard"
                style="@style/ShowHabit.Flow.HeaderStreakCard"
                android:layout_marginStart="@dimen/flow_body_padding"
                android:layout_marginEnd="@dimen/flow_body_padding"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="@dimen/flow_card_spacing" />

            <org.isoron.uhabits.activities.habits.show.views.HistoryCardView
                android:id="@+id/historyCard"
                style="@style/ShowHabit.Flow.BodyCard"
                android:gravity="center" />

            <org.isoron.uhabits.activities.habits.show.views.StreakCardView
                android:id="@+id/bestStreakCard"
                style="@style/ShowHabit.Flow.BodyCard"
                android:gravity="center" />

            <org.isoron.uhabits.activities.habits.show.views.BarCardView
                android:id="@+id/barCard"
                style="@style/ShowHabit.Flow.BodyCard"
                android:gravity="center" />

            <org.isoron.uhabits.activities.habits.show.views.StreakCardView
                android:id="@+id/previousStreakCard"
                style="@style/ShowHabit.Flow.BodyCard"
                android:gravity="center" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/moreStreaks"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/flow_card_spacing"
                android:background="@drawable/flow_touch_feedback"
                android:paddingHorizontal="24dp"
                android:text="@string/flow_streak_more"
                android:textAllCaps="false"
                android:textColor="?attr/flowTextSecondaryColor" />

            <TextView
                style="@style/ShowHabit.Flow.CardHeader"
                android:layout_marginStart="@dimen/flow_screen_padding"
                android:text="@string/flow_streak_habits" />

            <LinearLayout
                android:id="@+id/habitCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
