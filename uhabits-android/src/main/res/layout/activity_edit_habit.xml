<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/flowBackgroundColor"
    tools:context=".activities.habits.edit.EditHabitActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/flow_secondary_header_expanded_height"
            app:collapsedTitleTextColor="@android:color/transparent"
            app:contentScrim="@android:color/transparent"
            app:expandedTitleGravity="center_horizontal|bottom"
            app:expandedTitleMarginBottom="@dimen/flow_extra_large_spacing"
            app:expandedTitleMarginEnd="@dimen/flow_screen_padding"
            app:expandedTitleMarginStart="@dimen/flow_screen_padding"
            app:expandedTitleTextAppearance="@style/TextAppearance.Flow.ScreenTitle"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:statusBarScrim="@android:color/transparent">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/flow_toolbar_height"
                android:background="@android:color/transparent"
                android:elevation="0dp"
                android:theme="?attr/flowToolbarTheme"
                app:contentInsetEnd="0dp"
                app:contentInsetStartWithNavigation="0dp"
                app:layout_collapseMode="pin"
                app:popupTheme="?toolbarPopupTheme" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/editorScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/flow_editor_action_clearance"
        app:behavior_overlapTop="@dimen/flow_toolbar_height"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/flow_body_padding"
            android:paddingTop="@dimen/flow_large_spacing"
            android:paddingEnd="@dimen/flow_body_padding"
            android:paddingBottom="@dimen/flow_section_spacing">

            <TextView
                style="@style/Flow.Form.SectionLabel"
                android:text="@string/habit" />

            <LinearLayout
                style="@style/Flow.Form.Card"
                android:orientation="vertical">

                <TextView
                    style="@style/Flow.Form.Label"
                    android:text="@string/name" />

                <EditText
                    android:id="@+id/nameInput"
                    style="@style/Flow.Form.Input"
                    android:hint="@string/yes_or_no_short_example"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="50"
                    android:maxLines="2" />

                <View style="@style/Flow.Form.Divider" />

                <TextView
                    style="@style/Flow.Form.Label"
                    android:text="@string/flow_icon" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/iconButton"
                    style="@style/Flow.Form.Picker"
                    android:text="@string/flow_choose_emoji" />

                <View style="@style/Flow.Form.Divider" />

                <TextView
                    style="@style/Flow.Form.Label"
                    android:text="@string/question" />

                <EditText
                    android:id="@+id/questionInput"
                    style="@style/Flow.Form.Input"
                    android:hint="@string/example_question_boolean"
                    android:inputType="textCapSentences|textMultiLine" />

                <View style="@style/Flow.Form.Divider" />

                <TextView
                    style="@style/Flow.Form.Label"
                    android:text="@string/color" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/colorButton"
                    android:layout_width="64dp"
                    android:layout_height="@dimen/flow_min_touch_target"
                    android:layout_marginTop="@dimen/flow_medium_spacing"
                    android:background="@drawable/flow_color_swatch_background"
                    android:backgroundTint="#E23673"
                    android:contentDescription="@string/color" />

                <View style="@style/Flow.Form.Divider" />

                <TextView
                    style="@style/Flow.Form.Label"
                    android:text="@string/notes" />

                <EditText
                    android:id="@+id/notesInput"
                    style="@style/Flow.Form.Input"
                    android:hint="@string/example_notes"
                    android:inputType="textCapSentences|textMultiLine" />
            </LinearLayout>

            <TextView
                style="@style/Flow.Form.SectionLabel"
                android:layout_marginTop="@dimen/flow_section_spacing"
                android:text="@string/flow_schedule" />

            <LinearLayout
                style="@style/Flow.Form.Card"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/frequencyOuterBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Flow.Form.Label"
                            android:text="@string/frequency" />
                        <TextView
                            android:id="@+id/boolean_frequency_picker"
                            style="@style/Flow.Form.TextPicker"
                            android:text="@string/every_day" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/unitOuterBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Flow.Form.Label"
                            android:text="@string/unit" />
                        <EditText
                            android:id="@+id/unitInput"
                            style="@style/Flow.Form.Input"
                            android:hint="@string/measurable_units_example"
                            android:maxLines="1" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/targetOuterBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        style="@style/Flow.Form.Label"
                        android:text="@string/target" />
                    <EditText
                        android:id="@+id/targetInput"
                        style="@style/Flow.Form.Input"
                        android:hint="@string/example_target"
                        android:inputType="numberDecimal"
                        android:maxLines="1" />
                    <View style="@style/Flow.Form.Divider" />
                    <TextView
                        style="@style/Flow.Form.Label"
                        android:text="@string/frequency" />
                    <TextView
                        android:id="@+id/numericalFrequencyPicker"
                        style="@style/Flow.Form.TextPicker"
                        android:text="@string/every_week" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/targetTypeOuterBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <View style="@style/Flow.Form.Divider" />
                        <TextView
                            style="@style/Flow.Form.Label"
                            android:text="@string/target_type" />
                        <TextView
                            android:id="@+id/targetTypePicker"
                            style="@style/Flow.Form.TextPicker" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <TextView
                style="@style/Flow.Form.SectionLabel"
                android:layout_marginTop="@dimen/flow_section_spacing"
                android:text="@string/reminder" />

            <LinearLayout
                style="@style/Flow.Form.Card"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/reminderTimePicker"
                    style="@style/Flow.Form.TextPicker"
                    android:text="@string/reminder_off" />
                <View
                    android:id="@+id/reminderDivider"
                    style="@style/Flow.Form.Divider" />
                <TextView
                    android:id="@+id/reminderDatePicker"
                    style="@style/Flow.Form.TextPicker" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomActionBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/flow_editor_action_height"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/flow_screen_padding"
        android:layout_marginEnd="@dimen/flow_screen_padding"
        android:layout_marginBottom="@dimen/flow_large_spacing"
        app:cardBackgroundColor="?attr/flowSurfaceSecondaryColor"
        app:cardCornerRadius="@dimen/flow_dialog_radius"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/flow_medium_spacing"
            android:paddingEnd="@dimen/flow_medium_spacing">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDiscard"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/flow_discard"
                android:textAllCaps="false"
                android:textColor="?attr/flowTextSecondaryColor"
                app:rippleColor="?attr/flowRippleColor" />

            <View
                android:layout_width="@dimen/flow_divider_size"
                android:layout_height="28dp"
                android:background="?attr/flowDividerColor" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSave"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/save"
                android:textAllCaps="false"
                android:textColor="?attr/flowAccentColor"
                app:rippleColor="?attr/flowRippleColor" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
