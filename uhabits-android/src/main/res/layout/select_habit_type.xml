<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/flow_card_padding">

            <TextView
                android:id="@+id/title"
                style="@style/TextAppearance.Flow.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/flow_medium_spacing"
                android:fontFamily="sans-serif-medium"
                android:text="@string/create_habit"
                android:textSize="20sp" />

            <LinearLayout
                android:id="@+id/buttonYesNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:paddingVertical="12dp"
                android:background="@drawable/flow_card_selectable_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/flow_large_spacing"
                android:paddingEnd="@dimen/flow_large_spacing">

                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="16dp" android:src="@drawable/checkbox_checked" app:tint="?attr/flowAccentColor" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Flow.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/yes_or_no"
                        android:textStyle="bold" />
                    <TextView style="@style/TextAppearance.Flow.Supporting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/yes_or_no_example" />

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttonMeasurable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:paddingVertical="12dp"
                android:layout_marginTop="@dimen/flow_card_spacing"
                android:background="@drawable/flow_card_selectable_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/flow_large_spacing"
                android:paddingEnd="@dimen/flow_large_spacing">

                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="16dp" android:src="@drawable/flow_ic_habit_number" app:tint="?attr/flowAccentColor" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Flow.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/measurable"
                        android:textStyle="bold" />
                    <TextView style="@style/TextAppearance.Flow.Supporting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/measurable_example" />

                </LinearLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonCancel"
                style="@style/Widget.Flow.EntryAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:layout_marginTop="@dimen/flow_small_spacing"
                android:minHeight="48dp"
                android:text="@android:string/cancel"
                android:textSize="16sp" />
        </LinearLayout>
</ScrollView>
