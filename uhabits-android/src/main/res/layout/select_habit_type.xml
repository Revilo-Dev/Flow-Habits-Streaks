<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000"
    android:clickable="true"
    android:focusable="true"
    android:padding="@dimen/flow_screen_padding">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/dialogCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clickable="true"
        android:elevation="12dp"
        app:cardBackgroundColor="?attr/flowSurfaceColor"
        app:cardCornerRadius="@dimen/flow_dialog_radius"
        app:cardElevation="12dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/flow_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/flow_create_habit_title"
                android:textColor="?attr/flowTextPrimaryColor"
                android:textSize="@dimen/flow_text_sheet_title"
                android:textStyle="bold" />

            <TextView
                style="@style/TextAppearance.Flow.Supporting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/flow_small_spacing"
                android:layout_marginBottom="@dimen/flow_large_spacing"
                android:text="@string/flow_create_habit_message" />

            <LinearLayout
                android:id="@+id/buttonYesNo"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="@drawable/flow_surface_secondary_selectable_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/flow_large_spacing"
                android:paddingEnd="@dimen/flow_large_spacing">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/flow_ic_habit_binary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/flow_large_spacing"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Flow.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/yes_or_no"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.Flow.Metadata"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:text="@string/yes_or_no_example" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttonMeasurable"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="@dimen/flow_card_spacing"
                android:background="@drawable/flow_surface_secondary_selectable_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/flow_large_spacing"
                android:paddingEnd="@dimen/flow_large_spacing">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/flow_ic_habit_number" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/flow_large_spacing"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Flow.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/measurable"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.Flow.Metadata"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:text="@string/measurable_example" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/flow_min_touch_target"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/flow_medium_spacing"
                android:text="@android:string/cancel"
                android:textAllCaps="false"
                android:textColor="?attr/flowAccentColor"
                app:rippleColor="?attr/flowRippleColor" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
