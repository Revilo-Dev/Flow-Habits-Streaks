<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/flowBackgroundColor">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/flowBackgroundColor"
        android:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/flow_show_habit_header_expanded_height"
            app:collapsedTitleTextColor="?attr/flowTextPrimaryColor"
            app:contentScrim="?attr/flowBackgroundColor"
            app:expandedTitleTextColor="@android:color/transparent"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:statusBarScrim="?attr/flowBackgroundColor">

            <LinearLayout
                android:id="@+id/largeHeader"
                style="@style/ShowHabit.Flow.HeaderContent"
                android:layout_marginTop="@dimen/flow_toolbar_height"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="1.0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/habitIcon"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:gravity="center"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/habitTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/flow_large_spacing"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.Flow.ScreenTitle" />
                </LinearLayout>

                <org.isoron.uhabits.activities.habits.show.views.SubtitleCardView
                    android:id="@+id/subtitleCard"
                    style="@style/ShowHabit.Flow.Subtitle" />

                <org.isoron.uhabits.activities.habits.show.views.OverviewCardView
                    android:id="@+id/overviewCard"
                    style="@style/ShowHabit.Flow.HeaderCard" />

                <org.isoron.uhabits.activities.habits.show.views.FlowHabitStreakView
                    android:id="@+id/currentStreakCard"
                    style="@style/ShowHabit.Flow.HeaderStreakCard" />
            </LinearLayout>

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/flow_toolbar_height"
                android:background="@android:color/transparent"
                android:theme="?attr/flowToolbarTheme"
                app:layout_collapseMode="pin"
                app:popupTheme="?toolbarPopupTheme" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/flowBackgroundColor"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingTop="@dimen/flow_large_spacing"
            android:paddingBottom="@dimen/flow_large_spacing">

            <org.isoron.uhabits.activities.habits.show.views.HistoryCardView
                android:id="@+id/historyCard"
                style="@style/ShowHabit.Flow.BodyCard"
                android:gravity="center"
                android:paddingBottom="0dp" />

            <org.isoron.uhabits.activities.habits.show.views.ScoreCardView
                android:id="@+id/scoreCard"
                style="@style/ShowHabit.Flow.BodyCard"
                android:gravity="center" />

            <org.isoron.uhabits.activities.habits.show.views.BarCardView
                android:id="@+id/barCard"
                style="@style/ShowHabit.Flow.BodyCard"
                android:gravity="center" />

            <org.isoron.uhabits.activities.habits.show.views.NotesCardView
                android:id="@+id/notesCard"
                style="@style/ShowHabit.Flow.BodyCard"
                android:gravity="center" />

            <org.isoron.uhabits.activities.habits.show.views.TargetCardView
                android:id="@+id/targetCard"
                style="@style/ShowHabit.Flow.BodyCard" />

            <org.isoron.uhabits.activities.habits.show.views.FrequencyCardView
                android:id="@+id/frequencyCard"
                style="@style/ShowHabit.Flow.BodyCard" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
