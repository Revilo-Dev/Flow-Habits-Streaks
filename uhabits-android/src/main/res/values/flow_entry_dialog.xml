<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="flow_entry_position">Entry dialog position</string>
    <string name="flow_entry_position_summary">%s</string>
    <string name="flow_entry_position_center">Middle of screen</string>
    <string name="flow_entry_position_bottom">Bottom of screen</string>
    <string name="flow_entry_complete">Save completed entry</string>
    <string name="flow_entry_incomplete">Save missed entry</string>
    <string name="flow_entry_done">Done</string>
    <string name="flow_entry_skip">Skip</string>
    <string name="flow_entry_missed">Missed</string>
    <string name="flow_entry_zero">Zero</string>
    <string name="flow_entry_value">Value</string>
    <string name="flow_entry_save_value">Save value</string>
    <string name="flow_entry_save_zero">Save zero</string>
    <string name="flow_entry_invalid_number">Enter a valid number</string>
    <string-array name="flow_entry_position_entries">
        <item>@string/flow_entry_position_center</item>
        <item>@string/flow_entry_position_bottom</item>
    </string-array>
    <string-array name="flow_entry_position_values">
        <item>center</item>
        <item>bottom</item>
    </string-array>
    <style name="Widget.Flow.EntryAction" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:background">@drawable/flow_entry_action_background</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">2dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/flowTextPrimaryColor</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="FlowEntryDialog" parent="ThemeOverlay.MaterialComponents.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
