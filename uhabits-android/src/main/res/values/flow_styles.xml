<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Flow" parent="">
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Flow.ScreenTitle">
        <item name="android:textColor">?attr/flowTextPrimaryColor</item>
        <item name="android:textSize">@dimen/flow_text_screen_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Flow.SectionTitle">
        <item name="android:textColor">?attr/flowTextSecondaryColor</item>
        <item name="android:textSize">@dimen/flow_text_section_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Flow.Body">
        <item name="android:textColor">?attr/flowTextPrimaryColor</item>
        <item name="android:textSize">@dimen/flow_text_body</item>
    </style>

    <style name="TextAppearance.Flow.Supporting">
        <item name="android:textColor">?attr/flowTextSecondaryColor</item>
        <item name="android:textSize">@dimen/flow_text_supporting</item>
    </style>

    <style name="TextAppearance.Flow.Metadata">
        <item name="android:textColor">?attr/flowTextTertiaryColor</item>
        <item name="android:textSize">@dimen/flow_text_metadata</item>
    </style>

    <style name="Widget.Flow" parent="" />

    <style name="Widget.Flow.LargeHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/flow_screen_padding</item>
        <item name="android:paddingTop">@dimen/flow_header_top_spacing</item>
        <item name="android:paddingEnd">@dimen/flow_screen_padding</item>
        <item name="android:paddingBottom">@dimen/flow_header_bottom_spacing</item>
    </style>

    <style name="Widget.Flow.Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginStart">@dimen/flow_body_padding</item>
        <item name="android:layout_marginEnd">@dimen/flow_body_padding</item>
        <item name="android:layout_marginBottom">@dimen/flow_section_spacing</item>
    </style>

    <style name="Widget.Flow.Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/flow_card_background</item>
        <item name="android:padding">@dimen/flow_card_padding</item>
    </style>

    <style name="Widget.Flow.ListItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/flow_row_height</item>
        <item name="android:background">@drawable/flow_card_selectable_background</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/flow_row_horizontal_padding</item>
        <item name="android:paddingTop">@dimen/flow_row_vertical_padding</item>
        <item name="android:paddingEnd">@dimen/flow_row_horizontal_padding</item>
        <item name="android:paddingBottom">@dimen/flow_row_vertical_padding</item>
    </style>

    <style name="Widget.Flow.PreferenceItem" parent="Widget.Flow.ListItem">
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
    </style>

    <style name="ShapeAppearance.Flow.Card" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/flow_card_radius</item>
    </style>

    <style name="ShapeAppearance.Flow.Control" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/flow_control_radius</item>
    </style>

    <style name="Widget.Flow.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/flow_min_touch_target</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/flowOnAccentColor</item>
        <item name="backgroundTint">?attr/flowAccentColor</item>
        <item name="rippleColor">?attr/flowRippleColor</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Flow.Control</item>
    </style>

    <style name="Widget.Flow.IconButton" parent="Widget.MaterialComponents.Button.TextButton.Icon">
        <item name="android:minWidth">@dimen/flow_min_touch_target</item>
        <item name="android:minHeight">@dimen/flow_min_touch_target</item>
        <item name="android:padding">@dimen/flow_medium_spacing</item>
        <item name="rippleColor">?attr/flowRippleColor</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Flow.Control</item>
    </style>

    <style name="Widget.Flow.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="android:minWidth">@dimen/flow_min_touch_target</item>
        <item name="android:minHeight">@dimen/flow_min_touch_target</item>
        <item name="buttonTint">?attr/flowAccentColor</item>
    </style>

    <style name="FlowPopupTheme" parent="ThemeOverlay.MaterialComponents">
        <item name="android:colorBackground">?attr/flowSurfaceSecondaryColor</item>
        <item name="android:textColor">?attr/flowTextPrimaryColor</item>
        <item name="android:textColorPrimary">?attr/flowTextPrimaryColor</item>
        <item name="android:textColorSecondary">?attr/flowTextSecondaryColor</item>
        <item name="colorControlHighlight">?attr/flowRippleColor</item>
        <item name="popupMenuStyle">@style/Widget.Flow.PopupMenu</item>
    </style>

    <style name="Widget.Flow.PopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/flow_popup_background</item>
        <item name="android:dropDownVerticalOffset">8dp</item>
    </style>

    <style name="Widget.Flow.Dropdown" parent="Widget.AppCompat.Spinner.DropDown">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/flow_dropdown_background</item>
        <item name="android:dropDownSelector">?android:attr/selectableItemBackground</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
        <item name="android:popupBackground">@drawable/flow_popup_background</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">36dp</item>
        <item name="android:popupElevation">8dp</item>
        <item name="android:textColor">?attr/flowTextSecondaryColor</item>
    </style>

    <style name="Widget.Flow.InlineDropdown" parent="Widget.AppCompat.Spinner.DropDown">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:dropDownSelector">?android:attr/selectableItemBackground</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
        <item name="android:popupBackground">@drawable/flow_popup_background</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:popupElevation">8dp</item>
        <item name="android:textColor">?attr/flowTextSecondaryColor</item>
    </style>

    <style name="FlowDialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorBackground">?attr/flowSurfaceColor</item>
        <item name="android:textColor">?attr/flowTextPrimaryColor</item>
        <item name="android:textColorPrimary">?attr/flowTextPrimaryColor</item>
        <item name="android:textColorSecondary">?attr/flowTextSecondaryColor</item>
        <item name="android:textColorAlertDialogListItem">?attr/flowTextPrimaryColor</item>
        <item name="android:windowBackground">@drawable/flow_dialog_background</item>
        <item name="colorAccent">?attr/flowAccentColor</item>
        <item name="colorControlActivated">?attr/flowAccentColor</item>
        <item name="colorControlHighlight">?attr/flowRippleColor</item>
        <item name="colorSurface">?attr/flowSurfaceSecondaryColor</item>
    </style>

    <style name="FlowBottomSheet" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="android:fontFamily">sans-serif</item>
        <item name="bottomSheetStyle">@style/Widget.Flow.BottomSheet</item>
    </style>

    <style name="Widget.Flow.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@drawable/flow_bottom_sheet_background</item>
    </style>

    <style name="Flow.Form.SectionLabel" parent="TextAppearance.Flow.SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/flow_medium_spacing</item>
        <item name="android:layout_marginBottom">@dimen/flow_medium_spacing</item>
    </style>

    <style name="Flow.Form.Card" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/flow_card_background</item>
        <item name="android:padding">@dimen/flow_card_padding</item>
    </style>

    <style name="Flow.Form.Label" parent="TextAppearance.Flow.Metadata">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Flow.Form.Input" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/flow_min_touch_target</item>
        <item name="android:layout_marginTop">@dimen/flow_small_spacing</item>
        <item name="android:background">@drawable/flow_surface_secondary_background</item>
        <item name="android:paddingStart">@dimen/flow_large_spacing</item>
        <item name="android:paddingTop">@dimen/flow_small_spacing</item>
        <item name="android:paddingEnd">@dimen/flow_large_spacing</item>
        <item name="android:paddingBottom">@dimen/flow_small_spacing</item>
        <item name="android:textColor">?attr/flowTextPrimaryColor</item>
        <item name="android:textColorHint">?attr/flowTextTertiaryColor</item>
        <item name="android:textSize">@dimen/flow_text_body</item>
    </style>

    <style name="Flow.Form.Picker" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/flow_min_touch_target</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/flowTextPrimaryColor</item>
        <item name="android:textSize">@dimen/flow_text_body</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="rippleColor">?attr/flowRippleColor</item>
    </style>

    <style name="Flow.Form.TextPicker" parent="TextAppearance.Flow.Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/flow_min_touch_target</item>
        <item name="android:layout_marginTop">@dimen/flow_small_spacing</item>
        <item name="android:background">@drawable/flow_surface_secondary_background</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/flow_large_spacing</item>
        <item name="android:paddingEnd">@dimen/flow_large_spacing</item>
    </style>

    <style name="Flow.Form.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/flow_divider_size</item>
        <item name="android:layout_marginTop">@dimen/flow_large_spacing</item>
        <item name="android:layout_marginBottom">@dimen/flow_large_spacing</item>
        <item name="android:background">?attr/flowDividerColor</item>
    </style>

    <style name="ShowHabit.Flow.HeaderContent" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/flow_screen_padding</item>
        <item name="android:paddingTop">@dimen/flow_large_spacing</item>
        <item name="android:paddingEnd">@dimen/flow_screen_padding</item>
        <item name="android:paddingBottom">@dimen/flow_large_spacing</item>
    </style>

    <style name="ShowHabit.Flow.HeaderCard" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/flow_card_spacing</item>
        <item name="android:background">@drawable/flow_card_background</item>
        <item name="android:elevation">@dimen/flow_card_elevation</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/flow_card_padding</item>
    </style>

    <style name="ShowHabit.Flow.HeaderStreakCard" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/flow_card_spacing</item>
    </style>

    <style name="ShowHabit.Flow.BodyCard" parent="ShowHabit.Flow.HeaderCard">
        <item name="android:layout_marginStart">@dimen/flow_body_padding</item>
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:layout_marginEnd">@dimen/flow_body_padding</item>
        <item name="android:layout_marginBottom">@dimen/flow_card_spacing</item>
    </style>

    <style name="ShowHabit.Flow.Subtitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/flow_medium_spacing</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/flow_medium_spacing</item>
        <item name="android:paddingEnd">@dimen/flow_medium_spacing</item>
    </style>

    <style name="ShowHabit.Flow.CardHeader" parent="TextAppearance.Flow.SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/flow_card_spacing</item>
        <item name="android:drawablePadding">@dimen/flow_medium_spacing</item>
        <item name="android:gravity">center_vertical</item>
    </style>
</resources>
